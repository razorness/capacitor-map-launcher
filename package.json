{
  "name": "capacitor-map-launcher",
  "version": "0.0.1",
  "description": "Opens coordinates in native map apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "CapacitorMapLauncher.podspec"
  ],
  "author": "Volker Nauruhn <mensch.meier@live.de>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razorness/capacitor-map-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/razorness/capacitor-map-launcher/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "scripts": {
    "verify": "pnpm run verify:ios && pnpm run verify:android && pnpm run verify:web",
    "verify:ios": "xcodebuild -scheme CapacitorMapLauncher -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "pnpm run build",
    "lint": "pnpm run eslint && pnpm run swiftlint",
    "fmt": "pnpm run eslint --fix && swiftlint --fix --format",
    "eslint": "eslint .",
    "swiftlint": "swiftlint lint",
    "docgen": "docgen --api MapLauncherPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "pnpm run clean && pnpm run docgen && tsc --noEmit && tsdown",
    "clean": "rimraf ./dist",
    "watch": "tsdown --watch",
    "prepublishOnly": "pnpm run build",
    "up:deps": "pnpm dlx taze major -I",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/docgen": "0.3.0",
    "@capacitor/ios": "^8.5.2",
    "@ionic/eslint-config": "^0.5.0",
    "eslint": "^10.12.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.9.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
