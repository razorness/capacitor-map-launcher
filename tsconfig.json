{
	"compilerOptions": {
		"allowUnreachableCode": false,
		"declaration": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": [
			"dom",
			"es2017"
		],
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"rootDir": "src",
		"pretty": true,
		"strict": true,
		"target": "es2017"
	},
	"files"          : [
		"src/index.ts"
	]
}
